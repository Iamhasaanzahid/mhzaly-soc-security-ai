# Copy this file to .streamlit/secrets.toml (local dev) or paste its
# contents into your hosting platform's "Secrets" panel (e.g. Streamlit
# Community Cloud -> App settings -> Secrets). NEVER commit the real
# secrets.toml to version control.

# ── Required: operator login (no default credential exists in code — the
#    app refuses to start the login screen without both of these set) ──
APP_USERNAME = "change-me"
APP_PASSWORD = "change-me-to-a-long-random-passphrase"

# ── Optional: threat intel / vuln intel API keys (free tiers work, just
#    with lower rate limits) ──
VIRUSTOTAL_API_KEY = ""
ABUSEIPDB_API_KEY = ""
NVD_API_KEY = ""
GROQ_API_KEY = ""
ZOOMEYE_API_KEY = ""

# ── Optional: Autonomous SOC alerting ──
DISCORD_WEBHOOK_URL = ""

# ── Optional: production hardening knobs (sane defaults apply if unset) ──
# Auto-logout an idle operator after this many minutes.
SESSION_TIMEOUT_MINUTES = 30
# Soft, per-operator, per-day cap on "active scan" button presses (recon /
# infra audit / autonomous pipeline). Resets on app restart — see the
# docstring on check_and_increment_scan_quota() in the app for why this is
# a courtesy guard, not a hard security control.
MAX_ACTIVE_SCANS_PER_DAY = 100
