# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Secrets (NEVER commit these) ──────────────────────────────────────────────
.streamlit/secrets.toml
secrets.toml
config.json
.env
.env.*
!.env.example

# ── Tooling caches ────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Runtime artefacts ─────────────────────────────────────────────────────────
# The SOC database IS intentionally tracked (it is the platform's persistent
# state and the GitHub Actions cron commits it). Keep it out of this list.
*.log
